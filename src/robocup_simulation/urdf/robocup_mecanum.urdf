<?xml version="1.0"?>
<robot name="robocup_mecanum">
  <link name="base_link">
    <visual><geometry><box size="0.55 0.45 0.20"/></geometry><origin xyz="0 0 0.18"/></visual>
    <collision><geometry><box size="0.55 0.45 0.20"/></geometry><origin xyz="0 0 0.18"/></collision>
    <inertial><mass value="12"/><origin xyz="0 0 0.18"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>
  <link name="laser_link"><visual><geometry><cylinder radius="0.05" length="0.06"/></geometry><origin xyz="0 0 0.34"/></visual></link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0 0 0.34"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.08 0.08 0.05"/></geometry><origin xyz="0.18 0 0.50"/></visual></link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.18 0 0.50"/></joint>
</robot>
