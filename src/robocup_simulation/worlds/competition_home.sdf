<?xml version="1.0"?>
<sdf version="1.7">
  <world name="competition_home">
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 18 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.15 0.15 0.15 1</background></scene>
    <physics name="default_physics" type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <!--
      Competition plan reconstructed from the supplied drawing.
      Outer dimensions: 9.00 m x 13.33 m. The 6.60 m dimension runs
      between the two inner side walls; the 1.20 m strips at both sides
      are circulation/recreation areas. Room dimensions are 4.50 m,
      3.50 m, 4.00 m and 3.00 m as marked in the drawing.
    -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <collision name="outer_top"><geometry><box><size>9.0 0.12 0.6</size></box></geometry><pose>0 6.665 0.3 0 0 0</pose></collision>
        <visual name="v_outer_top"><geometry><box><size>9.0 0.12 0.6</size></box></geometry><pose>0 6.665 0.3 0 0 0</pose></visual>
        <collision name="outer_bottom"><geometry><box><size>9.0 0.12 0.6</size></box></geometry><pose>0 -6.665 0.3 0 0 0</pose></collision>
        <visual name="v_outer_bottom"><geometry><box><size>9.0 0.12 0.6</size></box></geometry><pose>0 -6.665 0.3 0 0 0</pose></visual>
        <collision name="outer_left"><geometry><box><size>0.12 13.33 0.6</size></box></geometry><pose>-4.5 0 0.3 0 0 0</pose></collision>
        <visual name="v_outer_left"><geometry><box><size>0.12 13.33 0.6</size></box></geometry><pose>-4.5 0 0.3 0 0 0</pose></visual>
        <collision name="outer_right"><geometry><box><size>0.12 13.33 0.6</size></box></geometry><pose>4.5 0 0.3 0 0 0</pose></collision>
        <visual name="v_outer_right"><geometry><box><size>0.12 13.33 0.6</size></box></geometry><pose>4.5 0 0.3 0 0 0</pose></visual>
        <!-- Inner side walls. Door openings are represented by separate segments. -->
        <collision name="inner_left_top"><geometry><box><size>0.12 5.0 0.6</size></box></geometry><pose>-3.3 4.165 0.3 0 0 0</pose></collision>
        <visual name="v_inner_left_top"><geometry><box><size>0.12 5.0 0.6</size></box></geometry><pose>-3.3 4.165 0.3 0 0 0</pose></visual>
        <collision name="inner_left_bottom"><geometry><box><size>0.12 3.8 0.6</size></box></geometry><pose>-3.3 -2.465 0.3 0 0 0</pose></collision>
        <visual name="v_inner_left_bottom"><geometry><box><size>0.12 3.8 0.6</size></box></geometry><pose>-3.3 -2.465 0.3 0 0 0</pose></visual>
        <collision name="inner_right"><geometry><box><size>0.12 10.33 0.6</size></box></geometry><pose>3.3 1.5 0.3 0 0 0</pose></collision>
        <visual name="v_inner_right"><geometry><box><size>0.12 10.33 0.6</size></box></geometry><pose>3.3 1.5 0.3 0 0 0</pose></visual>
        <!-- Bedroom: 3.50 m wide and 4.50 m deep. -->
        <collision name="bedroom_left"><geometry><box><size>0.12 4.5 0.6</size></box></geometry><pose>-0.3 4.415 0.3 0 0 0</pose></collision>
        <visual name="v_bedroom_left"><geometry><box><size>0.12 4.5 0.6</size></box></geometry><pose>-0.3 4.415 0.3 0 0 0</pose></visual>
        <collision name="bedroom_bottom"><geometry><box><size>3.5 0.12 0.6</size></box></geometry><pose>1.45 2.165 0.3 0 0 0</pose></collision>
        <visual name="v_bedroom_bottom"><geometry><box><size>3.5 0.12 0.6</size></box></geometry><pose>1.45 2.165 0.3 0 0 0</pose></visual>
        <!-- Study: 3.00 m wide and 4.00 m deep. -->
        <collision name="study_right"><geometry><box><size>0.12 4.0 0.6</size></box></geometry><pose>-0.3 -3.165 0.3 0 0 0</pose></collision>
        <visual name="v_study_right"><geometry><box><size>0.12 4.0 0.6</size></box></geometry><pose>-0.3 -3.165 0.3 0 0 0</pose></visual>
        <collision name="study_bottom"><geometry><box><size>3.0 0.12 0.6</size></box></geometry><pose>-1.8 -5.165 0.3 0 0 0</pose></collision>
        <visual name="v_study_bottom"><geometry><box><size>3.0 0.12 0.6</size></box></geometry><pose>-1.8 -5.165 0.3 0 0 0</pose></visual>
        <!-- Living/study partition with a 0.80 m door opening. -->
        <collision name="partition_left"><geometry><box><size>1.8 0.12 0.6</size></box></geometry><pose>-2.4 -1.665 0.3 0 0 0</pose></collision>
        <visual name="v_partition_left"><geometry><box><size>1.8 0.12 0.6</size></box></geometry><pose>-2.4 -1.665 0.3 0 0 0</pose></visual>
        <collision name="partition_right"><geometry><box><size>1.0 0.12 0.6</size></box></geometry><pose>1.0 -1.665 0.3 0 0 0</pose></collision>
        <visual name="v_partition_right"><geometry><box><size>1.0 0.12 0.6</size></box></geometry><pose>1.0 -1.665 0.3 0 0 0</pose></visual>
      </link>
    </model>
    <!-- Furniture placeholders aligned with the supplied plan. -->
    <model name="dining_table"><static>true</static><pose>-2.1 4.2 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.4 0.8 0.7</size></box></geometry></collision></link></model>
    <model name="bed"><static>true</static><pose>1.45 4.2 0.3 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.8 1.0 0.6</size></box></geometry></collision></link></model>
    <model name="living_sofa"><static>true</static><pose>1.2 -0.2 0.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 0.55 0.5</size></box></geometry></collision></link></model>
    <model name="desk"><static>true</static><pose>-1.8 -3.6 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.3 0.65 0.7</size></box></geometry></collision></link></model>
    <model name="robocup_mecanum_sim">
      <pose>-2.1 -5.8 0.18 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>12</mass><inertia><ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="base_collision">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.55 0.45 0.16</size></box></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
      <visual name="base_visual"><geometry><box><size>0.55 0.45 0.20</size></box></geometry></visual>
        <sensor name="laser" type="ray">
          <pose>0 0 0.23 0 0 0</pose><update_rate>10</update_rate>
          <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12</max><resolution>0.01</resolution></range></ray>
          <plugin name="ray_sensor" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/</namespace>
              <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
          </plugin>
        </sensor>
        <sensor name="imu" type="imu"><pose>0 0 0.25 0 0 0</pose><always_on>true</always_on><update_rate>50</update_rate>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
            </linear_acceleration>
          </imu>
          <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
            <ros>
              <namespace>/</namespace>
              <remapping>~/out:=imu/data</remapping>
            </ros>
            <frame_name>base_link</frame_name>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
          </plugin>
        </sensor>
      </link>
      <link name="camera_link">
        <pose>0.20 0 0.48 0 0 0</pose>
        <sensor name="rgbd_camera" type="camera"><update_rate>15</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10</far></clip></camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/camera</namespace>
              <remapping>camera1/image_raw:=color/image_raw</remapping>
              <remapping>camera_info:=color/camera_info</remapping>
            </ros>
            <frame_name>camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
      <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.42</wheel_separation><wheel_diameter>0.16</wheel_diameter>
        <max_wheel_torque>20</max_wheel_torque><max_wheel_acceleration>1.0</max_wheel_acceleration>
        <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>true</publish_wheel_tf>
        <odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame>
      </plugin>
      <link name="left_wheel"><pose>0 0.24 -0.02 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -0.24 -0.02 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry><surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision><visual name="wheel_visual"><geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    </model>
  </world>
</sdf>
